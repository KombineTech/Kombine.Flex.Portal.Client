<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)..\NuGet.Client.Config</RestoreConfigFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Kombine.Flex.Portal.Client</PackageId><Version>0.4.3</Version>
    <IsPackable>true</IsPackable><PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Kombine Technology ApS</Authors><Company>Kombine Technology ApS</Company>
    <Copyright>Kombine Technology ApS</Copyright>
    <Description>Official typed HTTPS/JSON client from Kombine Technology ApS for the public Kombine Flex Portal APIs, with no dependencies on other Kombine libraries.</Description>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://kombinetech.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/KombineTech/Kombine.Flex.Portal.Client</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Add reusable activity-driven manager sessions for interactive and configured-account clients.</PackageReleaseNotes>
    <PackageTags>Flex;Portal;API;Client</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md;README.da.md;README.es.md" Pack="true" PackagePath="/" />
    <None Include="OPERATIONS.md" Pack="true" PackagePath="/" />
    <None Include="icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>
</Project>
